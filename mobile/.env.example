# TheHopper mobile app environment configuration
# Copy this file to `.env` and adjust values for your setup.
#
# EXPO_PUBLIC_API_URL takes precedence over the value baked into app.json's
# `extra` block, so this file is how you choose which backend the app talks to.
#
# WARNING: the deployed backend below runs LIVE Stripe keys. Pointing at it
# means checkout flows charge real cards. Use a local backend with test keys
# for development.

# Development: point to your locally-running FastAPI backend.
#   Start backend with: cd backend && source venv/bin/activate && uvicorn main:app --reload
#   On a physical device, use your computer's LAN IP instead of localhost.
# EXPO_PUBLIC_API_URL=http://localhost:8000/api

# Production (LIVE Stripe — real charges):
EXPO_PUBLIC_API_URL=https://thehopper-api.alchemycreativelounge.com/api
