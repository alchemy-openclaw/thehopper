{
  "expo": {
    "name": "KaraokeSpot",
    "slug": "karaokespot",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "scheme": "karaokespot",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "co.launchable.karaokespot",
      "buildNumber": "1",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "KaraokeSpot uses your location to find karaoke venues near you.",
        "NSPhotoLibraryUsageDescription": "Choose a photo to show other singers what this venue looks like."
      },
      "entitlements": {
        "com.apple.developer.usernotifications.time-sensitive": true
      }
    },
    "android": {
      "package": "co.launchable.karaokespot",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#0d0221",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-dev-client",
      "expo-web-browser",
      "expo-secure-store",
      "expo-splash-screen",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Show karaoke venues near you."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#ff2d95"
        }
      ],
      "expo-status-bar"
    ],
    "experiments": {
      "tscPaths": true
    },
    "extra": {
      "EXPO_PUBLIC_API_URL": "https://thehopper-api.alchemycreativelounge.com/api"
    }
  }
}
