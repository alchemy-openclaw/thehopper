#!/bin/bash
# pre-push guard: reject pushes that introduce machine artifacts or secrets.
# Recurring problem (Sep 2026): local tooling committed backend/venv/,
# frontend/node_modules/, a 0-byte thehopper.db blob (nearly clobbered the
# 24MB live prod DB), and .env files with live Stripe keys.
#
# Activate per clone:   git config core.hooksPath .githooks
# Bypass (emergencies): git push --no-verify

set -u
ZERO="0000000000000000000000000000000000000000"
PATTERN='(^|/)\.env$|(^|/)\.env\.[^/]+$|(^|/)[^/]*\.(db|sqlite|sqlite3)$|(^|/)\.?venv/|(^|/)node_modules/|(^|/)\.DS_Store$'

# Committed-on-purpose templates. ".env.example" is documentation — it lists
# the variable NAMES a developer must set, with placeholder values — and the
# pattern above matches it as if it were a real .env. Blocking it made every
# push of a new branch fail, since the new-branch path scans the whole tree.
#
# These are exempt from the path rule but NOT from inspection: a template that
# has had a real key pasted into it is still refused, below.
TEMPLATE='\.(example|sample|template|dist)$'

# Shapes of live credentials. Deliberately narrow — this only runs against
# files that already claimed to be templates.
SECRETISH='(sk_live_|pk_live_|rk_live_|sk_test_[A-Za-z0-9]{20,}|AKIA[0-9A-Z]{16}|-----BEGIN [A-Z ]*PRIVATE KEY-----)'

blocked=0

while read -r local_ref local_sha remote_ref remote_sha; do
    # branch deletion — nothing to check
    [ "$local_sha" = "$ZERO" ] && continue

    if [ "$remote_sha" = "$ZERO" ]; then
        # New branch. Scanning the full tip tree here re-flagged every
        # already-tracked file, so a branch off main could never be pushed.
        # Scan only the commits this push actually adds to the remote.
        new_commits=$(git rev-list "$local_sha" --not --remotes 2>/dev/null)
        if [ -z "$new_commits" ]; then
            files=""
        else
            oldest=$(printf '%s\n' "$new_commits" | tail -1)
            base=$(git rev-parse --verify --quiet "${oldest}^" || true)
            if [ -n "$base" ]; then
                files=$(git diff --name-only --diff-filter=ACMRT "$base..$local_sha")
            else
                # Root commit — there is no "before", so the tree is the diff.
                files=$(git ls-tree -r --name-only "$local_sha")
            fi
        fi
    else
        # Only files ADDED or MODIFIED by the new commits. --diff-filter=ACMRT
        # excludes deletions on purpose: `git diff --name-only` lists removed
        # paths too, so a commit that DELETES a leaked .env used to be refused
        # — punishing exactly the fix we want people to make.
        files=$(git diff --name-only --diff-filter=ACMRT "$remote_sha..$local_sha")
    fi

    [ -z "$files" ] && continue

    hits=$(printf '%s\n' "$files" | grep -E "$PATTERN" | grep -vE "$TEMPLATE" || true)

    # Templates get in, but only if they still look like templates.
    for tmpl in $(printf '%s\n' "$files" | grep -E "$PATTERN" | grep -E "$TEMPLATE" || true); do
        if git show "$local_sha:$tmpl" 2>/dev/null | grep -qE "$SECRETISH"; then
            hits=$(printf '%s\n%s' "$hits" "$tmpl (template contains what looks like a live key)")
        fi
    done

    hits=$(printf '%s\n' "$hits" | grep -v '^$' || true)
    if [ -n "$hits" ]; then
        echo "" >&2
        echo "pre-push: REFUSING — these paths look like machine artifacts or secrets:" >&2
        echo "$hits" >&2
        echo "" >&2
        echo "  untrack them:   git rm -r --cached <path>" >&2
        echo "  then gitignore:  echo '<path>' >> .gitignore" >&2
        echo "  (venv/, node_modules/, thehopper.db, .env are already in .gitignore —" >&2
        echo "   if these are staged, something new swept them in; check git status)" >&2
        echo "" >&2
        blocked=1
    fi
done

exit $blocked
